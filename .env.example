# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console, APIs and Services, Credentials).
# Authorized redirect URI for local work: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Meta Model API key (Meta developer platform). AI stays labeled simulated until this is set.
META_MODEL_API_KEY=

# Google Cloud Text-to-Speech API key (project zeno). Spoken replies use the
# browser voice until this is set.
GOOGLE_TTS_API_KEY=

# Neon Postgres connection string. Database features stay off until this is set.
DATABASE_URL=
